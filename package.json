{
  "name": "satyajit-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4000 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:site": "node scripts/check-site.mjs",
    "check:skills": "node skills/frontend/scripts/validate.mjs && node --test skills/frontend/scripts/collection.test.mjs",
    "validate": "npm run lint && npm run build && npm run check:site"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3"
  }
}
